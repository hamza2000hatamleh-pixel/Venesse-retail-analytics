table DimDate
	lineageTag: ee3068c3-b151-4dd2-b8de-ce67ee3b0f1f
	dataCategory: Time

	measure 'Last Sales Date' =
			
			var SelectedYear = SELECTEDVALUE(DimDate[year]) var StartDate = DATE(SelectedYear,1,1) var EndDate = DATE(SelectedYear,9,30) RETURN IF(
			    NOT ISBLANK(SelectedYear),CALCULATE([Total Net Revenue],REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[full_date],StartDate,EndDate)) )
		lineageTag: 54af1133-b45b-4ccb-918d-f20b195cf950

		annotation PBI_FormatHint = {"isGeneralNumber":true}

