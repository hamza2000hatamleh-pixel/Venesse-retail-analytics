table FactSales
	lineageTag: 4ed7021e-dcbe-4af4-b343-9573ff40cff6

	measure 'Total COGS' = CALCULATE(sum(FactSales[cogs]),FILTER(DimOrderStatus,DimOrderStatus[status_name] = "delivered"))
		lineageTag: 202c22ca-b10a-4882-adae-23f230ae257b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Net Revenue' = CALCULATE(sum(FactSales[net_revenue]),FILTER(DimOrderStatus,DimOrderStatus[status_name] = "delivered"))
		lineageTag: ea0c64bf-93e2-42b3-bea2-bec58f0f793c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit' = [Total Net Revenue] - [Total COGS]
		lineageTag: bb771abe-c307-4de7-b074-a25067c8917d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit Margin %' = DIVIDE([Gross Profit], [Total Net Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 18da9a27-1440-48e0-8b4d-778f647a69e8

	measure 'Previous Year Revenue' =
			var SelectedYear = SELECTEDVALUE(DimDate[year]) var PreviousYear_ = selectedyear - 1 VAR StartDate = DATE(PreviousYear_,1,1) var EndDate = DATE(PreviousYear_,9,30) RETURN if(NOT ISBLANK(SelectedYear),
			CALCULATE(
			    [Total Net Revenue],
			    REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[full_date],StartDate,EndDate)
			))
		formatString: \$#,0.000;(\$#,0.000);\$#,0.000
		lineageTag: 14e2973b-f9b2-4249-9356-52ca6f956f3e

	measure 'Current Year Revenue' =
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear, 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear, 9, 30)
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),
			    CALCULATE(
			        [Total Net Revenue],
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate
			        )
			    )
			)
		formatString: \$#,0.000;(\$#,0.000);\$#,0.000
		lineageTag: fc52b6e8-5d15-4310-b91a-a1da31b0755a

	measure 'Revenue YoY Change' = [Current Year Revenue] - [Previous Year Revenue]
		lineageTag: 6e19437d-4eb7-4c01-a636-712447fbf58a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue YoY Growth %' = DIVIDE([Revenue YoY Change], [Previous Year Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f4fa296a-762f-4cdb-a4a6-811b05470abb

	measure 'Previous Year Gross Profit YTD' = [Previous Year Revenue] - [Previous Year COGS]
		formatString: \$#,0.000;(\$#,0.000);\$#,0.000
		lineageTag: 3948cf5c-9823-41e8-817b-f1fb09754d90

	measure 'Current Year Gross Profit YTD' = [Current Year Revenue] - [Current Year COGS]
		formatString: \$#,0.000;(\$#,0.000);\$#,0.000
		lineageTag: 80e5507e-2c55-45e4-be1f-9cee02fbbe8f

	measure 'Current Year COGS' =
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear, 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear, 9, 30)
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),
			    CALCULATE(
			        [Total COGS],
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate
			        )
			    )
			)
		lineageTag: e9c9040b-db73-4804-a2b1-2e51de2dbc18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Profit YoY Growth %' = DIVIDE([Current Year Gross Profit YTD] - [Previous Year Gross Profit YTD], [Previous Year Gross Profit YTD])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0b73307a-4546-47cd-a7d2-13bfcb3e1a5d

	measure 'Current Year Profit Margin %' = DIVIDE([Current Year Gross Profit YTD],[Current Year Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d760e2ac-537d-4fcc-9094-22654ef17aa8

	measure 'Previous Year Profit Margin %' = DIVIDE([Previous Year Gross Profit YTD],[Previous Year Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4e470d28-84fa-4210-a0e7-5003d88a78cc

	measure 'Gross Profit Margin YoY Change (pp)' = ([Current Year Profit Margin %] - [Previous Year Profit Margin %] ) *100
		lineageTag: 2d222e15-8463-49d5-81eb-b38ff032520a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Year COGS' =
			var SelectedYear = SELECTEDVALUE(DimDate[year]) var PreviousYear_ = selectedyear - 1 VAR StartDate = DATE(PreviousYear_,1,1) var EndDate = DATE(PreviousYear_,9,30) RETURN if(NOT ISBLANK(SelectedYear),
			CALCULATE(
			    [Total COGS],
			    REMOVEFILTERS(DimDate),DATESBETWEEN(DimDate[full_date],StartDate,EndDate)
			))
		lineageTag: 4f29d075-a852-4ce3-8d87-0ed12ef9591f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

