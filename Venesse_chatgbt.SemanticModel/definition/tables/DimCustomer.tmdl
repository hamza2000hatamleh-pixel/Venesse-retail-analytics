	measure 'Cumulative Repeat Customers' =
			
			VAR CurrentMonthEnd =
			    MAX(DimDate[full_date])
			
			VAR StartDate =
			    DATE(YEAR(CurrentMonthEnd), 1, 1)
			
			RETURN
			    CALCULATE(
			        [Repeat Customer],
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            CurrentMonthEnd
			        )
			    )
		formatString: 0
		lineageTag: 434b16e6-8890-4039-80eb-97ffe5c34028

	measure 'Previous Year Cumulative Repeat Customers' =
			
			VAR CurrentMonthEnd =
			    MAX(DimDate[full_date])
			
			VAR CurrentMonth =
			    MONTH(CurrentMonthEnd)
			
			VAR CurrentYear =
			    YEAR(CurrentMonthEnd)
			
			VAR PreviousYear_ =
			    CurrentYear - 1
			
			VAR StartDate =
			    DATE(PreviousYear_, 1, 1)
			
			VAR EndDate =
			    EOMONTH(
			        DATE(PreviousYear_, CurrentMonth, 1),
			        0
			    )
			
			RETURN
			     CALCULATE([Repeat Customer],REMOVEFILTERS(dimdate),DATESBETWEEN(DimDate[full_date],StartDate,enddate))
