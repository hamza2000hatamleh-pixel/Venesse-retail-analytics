	measure 'PY Customer Cohort Count' =
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate_ =
			    DATE(SelectedYear-1, 1, 1)
			
			VAR EndDate_ =
			    DATE(SelectedYear-1, 9, 30)
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),CALCULATE([Total active customers],REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate_,
			            EndDate_)))
		formatString: 0
		lineageTag: ddf063d8-114a-435f-8c51-9fab6fdc9c57

	measure 'PY High Value Customer Count' =
			
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear - 1, 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear - 1, 9, 30)                                     VAR CustomerTable = CALCULATETABLE(
			        VALUES(FactSales[customer_id]),
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate
			        ),DimOrderStatus[status_name] = "delivered"
			    )VAR CustomerRevenueTable =
			    ADDCOLUMNS(
			        CustomerTable,
			        "PY Revenue",
			        [Previous Year Revenue]
			    )VAR RankedCustomers =
			    ADDCOLUMNS(
			        CustomerRevenueTable,
			        "Revenue Rank",
			        RANKX(
			            CustomerRevenueTable,
			            [PY Revenue],
			            ,
			            DESC,
			            DENSE
			        )
			    )VAR TotalCustomers =
			    COUNTROWS(RankedCustomers)
			
			VAR HighValueLimit =
			    ROUNDUP(TotalCustomers * 0.20, 0)
			
			VAR MediumValueLimit =
			    ROUNDUP(TotalCustomers * 0.50, 0)                                                                    VAR CustomerSegment = ADDCOLUMNS(RankedCustomers,"SegmentedCustomer",SWITCH(TRUE(),[Revenue Rank]<=HighValueLimit,"High Value", [Revenue Rank]<=MediumValueLimit,"Medium Value","Low Value"))RETURN
			    IF(
			        NOT ISBLANK(SelectedYear),
			        COUNTROWS(
			            FILTER(
			                CustomerSegment,
			                [SegmentedCustomer] = "High Value"
			            )
			        )
			    )
		formatString: 0
		lineageTag: 9d6c1639-a191-4030-a15b-8b9c4a52ecb2

	measure 'Retained Customers' =
			
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear , 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear , 9, 30)                                        VAR CYCustomerTable =  CALCULATETABLE(
			        VALUES(FactSales[customer_id]),
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate
			        ),DimOrderStatus[status_name] = "delivered")                                                  VAR StartDate_ =
			    DATE(SelectedYear - 1 , 1, 1)
			
			VAR EndDate_ =
			    DATE(SelectedYear -1 , 9, 30)                                        VAR PYCustomerTable =  CALCULATETABLE(
			        VALUES(FactSales[customer_id]),
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate_,
			            EndDate_
			        ),DimOrderStatus[status_name] = "delivered")  RETURN
			    IF(
			        NOT ISBLANK(SelectedYear),
			        COUNTROWS(
			            INTERSECT(PYCustomerTable, CYCustomerTable)
			        )
			    )
		formatString: 0
		lineageTag: d070f0a4-61bd-4195-b159-e5a842b031d3

