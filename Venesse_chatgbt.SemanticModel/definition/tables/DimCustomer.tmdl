	measure 'Repeat Customer Rate YoY Change (pp)' =
			
			VAR CurrentRate =
			    [Current Year Repeat Customer Rate Comparable]
			
			VAR PreviousRate =
			    [Previous Year Repeat Customer Rate]
			
			RETURN
			IF(
			    ISBLANK(CurrentRate) || ISBLANK(PreviousRate),
			    BLANK(),
			    (CurrentRate - PreviousRate) * 100
			)
