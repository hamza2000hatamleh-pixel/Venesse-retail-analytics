	measure 'Current Year Active Customer Comparable' =
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear, 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear, 9, 30)
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),CALCULATE([Total active customers],REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate)))
		formatString: 0
		lineageTag: c75f28d6-05cf-44eb-b4fd-e1f0710d6015

