	measure 'Repeat Customer' = ```
			
			VAR customers =
			    VALUES(DimCustomer[customer_id])
			
			VAR repeat_customers =
			    FILTER(
			        customers,
			        CALCULATE(
			            DISTINCTCOUNT(FactSales[order_id]),
			            DimOrderStatus[status_name] = "delivered"
			        ) >= 2 
			    )
			
			RETURN
			    COALESCE(
			        COUNTROWS(repeat_customers),
			        0
			    )
			```
		formatString: 0
		lineageTag: 0aa8b6d6-bfa3-4800-80be-e4dc5d500c0c

	measure 'Total active customers' = CALCULATE(DISTINCTCOUNT(FactSales[customer_id]),DimOrderStatus[status_name]="delivered")
		formatString: 0
