	measure 'PY Revenue at Risk by Segment' = ```
			
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear - 1, 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear - 1, 9, 30)                                     VAR PYCustomerTable = CALCULATETABLE(
			        VALUES(FactSales[customer_id]),
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate
			        ),DimOrderStatus[status_name] = "delivered"
			    )VAR CYCustomerTable = CALCULATETABLE(
			        VALUES(FactSales[customer_id]),
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            DATE(SelectedYear , 1, 1),
			            DATE(SelectedYear  , 9, 30) 
			        ),DimOrderStatus[status_name] = "delivered"
			    )VAR CustomerRevenueTable =
			    ADDCOLUMNS(
			        PYCustomerTable,
			        "PY Revenue",
			        [Previous Year Revenue]
			    )VAR RankedCustomers =
			    ADDCOLUMNS(
			        CustomerRevenueTable,
			        "Revenue Rank",
			        RANKX(
			            CustomerRevenueTable,
			            [PY Revenue],
			            ,
			            DESC,
			            DENSE
			        )
			    )VAR TotalCustomers =
			    COUNTROWS(RankedCustomers)
			
			VAR HighValueLimit =
			    ROUNDUP(TotalCustomers * 0.20, 0)
			
			VAR MediumValueLimit =
			    ROUNDUP(TotalCustomers * 0.50, 0)                                                                    VAR CustomerSegment = ADDCOLUMNS(RankedCustomers,"SegmentedCustomer",SWITCH(TRUE(),[Revenue Rank]<=HighValueLimit,"High Value", [Revenue Rank]<=MediumValueLimit,"Medium Value","Low Value"))VAR NonReturningCustomers =
			    EXCEPT(
			        PYCustomerTable,
			        CYCustomerTable
			    )VAR NonReturningSegmentedCustomers =
			    FILTER(
			        CustomerSegment,
			        CONTAINS(
			            NonReturningCustomers,
			            FactSales[customer_id],
			            FactSales[customer_id]
			        )
			    )var selectedsegment = VALUES(CustomerValueSegments[Value Segment]) RETURN
			    IF(
			        NOT ISBLANK(SelectedYear),
			        SUMX(
			            FILTER(
			                NonReturningSegmentedCustomers,
			                [SegmentedCustomer]
			                    IN VALUES(CustomerValueSegments[Value Segment])
			            ),
			            [PY Revenue]
			        )
			    )
			```
		lineageTag: 080d9c81-9658-4391-bfa4-0005da80778a

