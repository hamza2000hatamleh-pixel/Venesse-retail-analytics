table DimOrder
	lineageTag: cf777047-819e-4021-bb05-6a8c15062636

	measure 'Delivered Order Count' =
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			VAR StartDate =
			    DATE(SelectedYear, 1, 1)
			
			VAR EndDate =
			    DATE(SelectedYear, 9, 30)
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),CALCULATE(DISTINCTCOUNT(FactSales[order_id]),FILTER(DimOrderStatus,DimOrderStatus[status_name] = "delivered"), REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            StartDate,
			            EndDate
			        )))
		formatString: 0
		lineageTag: de476565-8832-4dfb-ac0d-2e58793904cf

	measure 'Customer Purchase Frequency Segmentation' = SWITCH(TRUE(), DimOrder[Delivered Order Count] = 1 , "One-Time Customer",DimOrder[Delivered Order Count] > 1 && DimOrder[Delivered Order Count] <= 3, "Repeat Customer", DimOrder[Delivered Order Count]>=4,"Loyal Customer")
		lineageTag: fd21b5d1-0870-40eb-9dc6-793cebae1d64

	measure 'One-Time Customer Count' =
			
			COUNTROWS(
			    FILTER(
			        VALUES(DimCustomer[customer_id]),
			        [Delivered Order Count] = 1
			    )
			)
		formatString: 0
		lineageTag: 925f21a5-99a1-4c80-9121-7be72f208520

	measure 'Loyal Customer Count' = ```
			COUNTROWS(
			    FILTER(
			        VALUES(DimCustomer[customer_id]),
			        [Delivered Order Count] >=4 
			    )
			)
			```
		formatString: 0
		lineageTag: dc34d94f-ca10-4c38-a85d-f48acaeb6cb3

	measure 'Repeat Customer(2-3)' =
			
			COALESCE(
			    COUNTROWS(
			        FILTER(
			            VALUES(DimCustomer[customer_id]),
			            [Delivered Order Count] >= 2
			                && [Delivered Order Count] <= 3
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: f5643acf-6f64-4b0a-ad11-4b92b8c9478e

	measure 'Previous Year Delivered Order Count' =
			
			VAR SelectedYear =
			    SELECTEDVALUE(DimDate[year])
			
			RETURN
			IF(
			    NOT ISBLANK(SelectedYear),
			    CALCULATE(
			        DISTINCTCOUNT(FactSales[order_id]),
			        DimOrderStatus[status_name] = "delivered",
			        REMOVEFILTERS(DimDate),
			        DATESBETWEEN(
			            DimDate[full_date],
			            DATE(SelectedYear - 1, 1, 1),
			            DATE(SelectedYear - 1, 9, 30)
			        )
			    )
			)
		formatString: 0
		lineageTag: 355e9f70-6100-4420-85d6-31102e9e76ad

