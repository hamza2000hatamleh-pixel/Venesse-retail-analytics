		summarizeBy: none
		sourceColumn: expense_name

		annotation SummarizationSetBy = Automatic

	column expense_category_id
		dataType: int64
		formatString: 0
		lineageTag: d6e48c40-c1d7-4c64-863b-e57942773f99
		summarizeBy: none
		sourceColumn: expense_category_id

		annotation SummarizationSetBy = Automatic

	column expense_date_key
		dataType: int64
		formatString: 0
		lineageTag: aa2f3acd-2ae5-4c8f-bb2c-e22772daeccb
		summarizeBy: none
		sourceColumn: expense_date_key

		annotation SummarizationSetBy = Automatic

	column expense_amount
		dataType: double
		lineageTag: d242bfba-042a-4b74-969c-3388dad66daf
		summarizeBy: sum
		sourceColumn: expense_amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition FactExpenses = m
		mode: import
		source =
				let
				    Source = Sql.Database("(local)", "Venesse"),
				    dbo_FactExpenses = Source{[Schema="dbo",Item="FactExpenses"]}[Data]
				in
